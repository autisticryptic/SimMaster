[Unit]
Description=SimAdmin secondary QMI endpoint initializer and monitor
After=systemd-udevd.service systemd-modules-load.service
Before=ModemManager.service simadmin.service

[Service]
Type=notify
NotifyAccess=all
# The QCM410 driver is UE-only. It always prepares the validated DATA6 native
# endpoint; when that hardware endpoint is absent, cellular data and VoLTE stay
# unavailable rather than falling back to a host-namespace bearer.
# Nothing here may name a channel, a driver, or a port. The initializer
# discovers the baseband layout at runtime -- it reads /sys/class/wwan/*/type,
# dedupes by baseband, and accepts an endpoint only after a QMI probe confirms
# the wds service. A hardcoded ExecCondition used to wait for DATA6_CNTL and
# skip the unit when it did not appear, which on any other layout also skipped
# the purge of the crash-inducing legacy module -- exactly what must always run.
#
# So the unit always starts the initializer and lets it decide.
#
# Waiting for the modem is the initializer's job, not this unit's. `udevadm
# settle` cannot do it: it drains the event queue and returns immediately when
# the device does not exist yet, which is precisely the case here -- this unit is
# ordered before ModemManager and therefore runs well before the firmware
# attaches its wwan ports (~13 s after kernel start on the 410, rpmsg channels
# later still). So this step only loads the driver, best-effort, because a
# platform may have it built in or no rpmsg at all.
ExecStartPre=-/bin/sh -c 'modprobe rpmsg_wwan_ctrl 2>/dev/null || true'
ExecStart=/opt/simadmin/simadmin device-init
Restart=on-failure
RestartSec=2
# Must exceed the initializer's own port wait (45 s) plus per-endpoint bind and
# QMI probe time, or systemd kills it mid-probe and restarts it on a loop.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
