# Keep ModemManager off the QMI endpoints that SimAdmin uses for IMS/VoLTE.
#
# `simadmin secondary-qmi-init` regenerates an equivalent rule at
# /run/udev/rules.d/99-simadmin-secondary-qmi.rules using the port names it
# actually bound, which is the authoritative source. This static file is a
# fallback for the common Qualcomm layout where the spare channels surface as
# wwan<N>qmi1 / wwan<N>qmi2.
#
# ModemManager must keep wwan<N>qmi0 (the primary port) for normal mobile data —
# it is deliberately NOT ignored here.
SUBSYSTEM=="wwan", KERNEL=="wwan[0-9]qmi1", ENV{ID_MM_PORT_IGNORE}="1"
SUBSYSTEM=="wwan", KERNEL=="wwan[0-9]qmi2", ENV{ID_MM_PORT_IGNORE}="1"
