[simadmin-lab-global]
type=global
endpoint_identifier_order=auth_username,username,ip

[simadmin-lab-transport]
type=transport
protocol=udp
bind=@BIND_IP@:@BIND_PORT@
local_net=127.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[41000-auth]
type=auth
auth_type=userpass
username=41000
password=@SIMADMIN_TRUNK_SECRET@
realm=asterisk

[41000]
type=aor
max_contacts=1
remove_existing=yes
minimum_expiration=60
maximum_expiration=86400
default_expiration=60

[41000]
type=endpoint
transport=simadmin-lab-transport
context=from-simadmin
message_context=simadmin-trunk-msg
auth=41000-auth
aors=41000
identify_by=auth_username,username,ip
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=info
send_pai=yes
trust_id_inbound=yes

[41000-identify]
type=identify
endpoint=41000-incoming
match=@WINDOWS_HOST_IP@
match=192.168.100.13

[41000-incoming]
type=endpoint
transport=simadmin-lab-transport
context=from-simadmin
message_context=simadmin-trunk-msg
identify_by=ip
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=info
send_pai=yes
trust_id_inbound=yes

[6108-auth]
type=auth
auth_type=userpass
username=6108
password=@LINPHONE_SECRET@
realm=asterisk

[6108]
type=aor
max_contacts=2
remove_existing=yes
minimum_expiration=60
maximum_expiration=86400

[6108]
type=endpoint
transport=simadmin-lab-transport
context=from-linphone
message_context=simadmin-linphone-msg
auth=6108-auth
aors=6108
identify_by=auth_username,username
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=info
