meta {
  name: set_vilte_config
  type: http
  seq: 173
}

post {
  url: {{base_url}}/api/modem/lines/{{line_id}}/vilte/config
  body: json
  auth: inherit
}

body:json {
  {
    "feature_enabled": true,
    "codec": "h264",
    "video_payload_type": 99,
    "h264_fmtp": "profile-level-id=42e01f;packetization-mode=1"
  }
}

settings {
  encodeUrl: true
}
