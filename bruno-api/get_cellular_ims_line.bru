meta {
  name: get_cellular_ims_line
  type: http
  seq: 153
}

get {
  url: {{base_url}}/api/cellular-ims/lines/{{line_id}}
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
}

docs {
  data.runtime.diagnostics is the same execution-facts projection as three_gpp.diagnostics
  in GET /api/modem/lines/{line_id}/ims/status. It records actual profile/identity sources,
  requested/granted family, endpoint transport, offered/accepted security and real waiting.
  Negotiation history never grants current readiness; no identity or authentication values
  are included in diagnostics. Reading diagnostics does not request a reconnect.
}
