meta {
  name: get_vowifi_status
  type: http
  seq: 140
}

get {
  url: {{base_url}}/api/vowifi/lines/{{line_id}}/status?live=true
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
}

docs {
  This existing request deliberately retains live=true and may run the bounded live probe.
  For passive execution facts without requesting a probe, use get_ims_status instead.
  data.diagnostics is execution evidence, not the profile declaration or current readiness.
}
